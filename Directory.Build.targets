<Project>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <None Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)\*.dll" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '$(RuntimeIdentifier)' == '' and ($([System.String]::Copy('$(TargetFramework)').Contains('-windows')) or $([System.String]::Copy('$(DefineConstants)').Contains('WINDOWS_DESKTOP_HOST')) or $([System.String]::Copy('$(DefineConstants)').Contains('HEADLESS_HOST')))">
    <None Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\win-x64\*.dll" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\win-x64')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">
    <None Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)\*.so" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">
    <None Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)\*.dylib" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\$(RuntimeIdentifier)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser' and '$(RuntimeIdentifier)' == 'browser-wasm'">
    <BgfXnaBrowserWasmNativeRuntimeDirectory>$(BgfXnaNativeRuntimeRoot)$(Configuration)\browser-wasm</BgfXnaBrowserWasmNativeRuntimeDirectory>
    <BgfXnaBrowserWasmNativeRuntimeDirectory Condition="!Exists('$(BgfXnaBrowserWasmNativeRuntimeDirectory)') and Exists('$(BgfXnaNativeRuntimeRoot)Release\browser-wasm')">$(BgfXnaNativeRuntimeRoot)Release\browser-wasm</BgfXnaBrowserWasmNativeRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser' and '$(RuntimeIdentifier)' == 'browser-wasm'">
    <NativeFileReference Include="$(BgfXnaBrowserWasmNativeRuntimeDirectory)\*.a" Condition="Exists('$(BgfXnaBrowserWasmNativeRuntimeDirectory)')" />
  </ItemGroup>

  <Target Name="BgfXnaRequireBrowserWasmNativeBgfx"
          BeforeTargets="Build"
          Condition="'$(TargetFramework)' == 'net10.0-browser' and '$(RuntimeIdentifier)' == 'browser-wasm' and '$(DesignTimeBuild)' != 'true' and !Exists('$(BgfXnaBrowserWasmNativeRuntimeDirectory)')">
    <Error Text="BGFX browser-wasm native libraries were not found at '$(BgfXnaNativeRuntimeRoot)$(Configuration)\browser-wasm' or '$(BgfXnaNativeRuntimeRoot)Release\browser-wasm'. Build them with: dotnet run .\scripts\build-bgfx.cs -- --target browser-wasm --configuration Release --source-root native-src --skip-clone" />
  </Target>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <BgfXnaIosNativeConfiguration Condition="'$(BgfXnaIosNativeConfiguration)' == ''">Release</BgfXnaIosNativeConfiguration>
    <BgfXnaIosNativeArchiveSuffix Condition="'$(BgfXnaIosNativeConfiguration)' == 'Debug'">Debug</BgfXnaIosNativeArchiveSuffix>
    <BgfXnaIosNativeArchiveSuffix Condition="'$(BgfXnaIosNativeArchiveSuffix)' == ''">Release</BgfXnaIosNativeArchiveSuffix>
    <BgfXnaIosNativeTarget Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-'))">ios-simulator</BgfXnaIosNativeTarget>
    <BgfXnaIosNativeTarget Condition="'$(BgfXnaIosNativeTarget)' == ''">ios-arm64</BgfXnaIosNativeTarget>
    <BgfXnaIosNativeRuntimeDirectory>$(BgfXnaNativeRuntimeRoot)$(BgfXnaIosNativeConfiguration)\$(BgfXnaIosNativeTarget)</BgfXnaIosNativeRuntimeDirectory>
  </PropertyGroup>

  <Target Name="BgfXnaRequireIosNativeBgfx"
          BeforeTargets="Build"
          Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(MSBuildProjectName)' != 'BgfXna' and '$(DesignTimeBuild)' != 'true' and !Exists('$(BgfXnaIosNativeRuntimeDirectory)')">
    <Error Text="BGFX iOS native libraries were not found at '$(BgfXnaIosNativeRuntimeDirectory)'. Build them on macOS with: dotnet run ./scripts/build-bgfx.cs -- --target $(BgfXnaIosNativeTarget) --configuration $(BgfXnaIosNativeConfiguration) --source-root native-src --skip-clone" />
  </Target>

  <Target Name="BgfXnaValidateIosNativeBgfx"
          BeforeTargets="Build"
          Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(MSBuildProjectName)' != 'BgfXna' and '$(DesignTimeBuild)' != 'true' and Exists('$(BgfXnaIosNativeRuntimeDirectory)')">
    <ItemGroup>
      <_BgfXnaIosBgfxArchive Include="$(BgfXnaIosNativeRuntimeDirectory)\*bgfx*.a" />
      <_BgfXnaIosBimgArchive Include="$(BgfXnaIosNativeRuntimeDirectory)\*bimg*.a" />
      <_BgfXnaIosBxArchive Include="$(BgfXnaIosNativeRuntimeDirectory)\*bx*.a" />
    </ItemGroup>
    <Error Condition="'@(_BgfXnaIosBgfxArchive)' == ''" Text="No BGFX iOS bgfx archive was found in '$(BgfXnaIosNativeRuntimeDirectory)'." />
    <Error Condition="'@(_BgfXnaIosBimgArchive)' == ''" Text="No BGFX iOS bimg archive was found in '$(BgfXnaIosNativeRuntimeDirectory)'." />
    <Error Condition="'@(_BgfXnaIosBxArchive)' == ''" Text="No BGFX iOS bx archive was found in '$(BgfXnaIosNativeRuntimeDirectory)'." />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(MSBuildProjectName)' != 'BgfXna' and Exists('$(BgfXnaIosNativeRuntimeDirectory)')">
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(BgfXnaIosNativeRuntimeDirectory)\libbgfx$(BgfXnaIosNativeArchiveSuffix).a" />
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(BgfXnaIosNativeRuntimeDirectory)\libbimg$(BgfXnaIosNativeArchiveSuffix).a" />
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(BgfXnaIosNativeRuntimeDirectory)\libbimg_decode$(BgfXnaIosNativeArchiveSuffix).a" />
    <LinkerArgument Include="-force_load" />
    <LinkerArgument Include="$(BgfXnaIosNativeRuntimeDirectory)\libbx$(BgfXnaIosNativeArchiveSuffix).a" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="Metal" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="QuartzCore" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="UIKit" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="Foundation" />
    <LinkerArgument Include="-framework" />
    <LinkerArgument Include="CoreGraphics" />
    <_LinkNativeExecutableInputs Include="$(BgfXnaIosNativeRuntimeDirectory)\libbgfx$(BgfXnaIosNativeArchiveSuffix).a" />
    <_LinkNativeExecutableInputs Include="$(BgfXnaIosNativeRuntimeDirectory)\libbimg$(BgfXnaIosNativeArchiveSuffix).a" />
    <_LinkNativeExecutableInputs Include="$(BgfXnaIosNativeRuntimeDirectory)\libbimg_decode$(BgfXnaIosNativeArchiveSuffix).a" />
    <_LinkNativeExecutableInputs Include="$(BgfXnaIosNativeRuntimeDirectory)\libbx$(BgfXnaIosNativeArchiveSuffix).a" />
  </ItemGroup>

  <Target Name="BgfXnaExcludeIosRuntimeDylibPlaceholdersFromNativeLink"
          BeforeTargets="_ComputeLinkNativeExecutableInputs"
          Condition="'$(TargetFramework)' == 'net10.0-ios' and '$(MSBuildProjectName)' != 'BgfXna' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BgfXnaIosRuntimeDylibPlaceholder Include="$(_IntermediateNativeLibraryDir)*.dylib" />
      <_BgfXnaIosRuntimeDylibPlaceholder Include="$(IntermediateOutputPath)nativelibraries/*.dylib" />
      <_BgfXnaIosRuntimeDylibPlaceholder Include="$(DeviceSpecificIntermediateOutputPath)nativelibraries/*.dylib" />
      <_FileNativeReference Update="@(_BgfXnaIosRuntimeDylibPlaceholder)">
        <LinkToExecutable>false</LinkToExecutable>
      </_FileNativeReference>
      <_LinkNativeExecutableInputs Remove="@(_BgfXnaIosRuntimeDylibPlaceholder)" />
      <_LinkNativeExecutableInputs Remove="$(IntermediateOutputPath)nativelibraries/*.dylib" />
      <_LinkNativeExecutableInputs Remove="$(DeviceSpecificIntermediateOutputPath)nativelibraries/*.dylib" />
    </ItemGroup>
    <Message Importance="low" Text="Removed iOS runtime dylib placeholders from native link: @(_BgfXnaIosRuntimeDylibPlaceholder)" Condition="'@(_BgfXnaIosRuntimeDylibPlaceholder)' != ''" />
  </Target>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'BgfXna' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([System.String]::Copy('$(TargetFramework)').Contains('-android'))">
    <AndroidNativeLibrary Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-arm64\libbgfx*.so" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-arm64')">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-arm\libbgfx*.so" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-arm')">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-x64\libbgfx*.so" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-x64')">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-x86\libbgfx*.so" Condition="Exists('$(BgfXnaNativeRuntimeRoot)$(Configuration)\android-x86')">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>
</Project>
