<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BrowserGraphicsBackends Condition="'$(BrowserGraphicsBackends)' == ''"
      >Both</BrowserGraphicsBackends
    >
    <DefineConstants>$(DefineConstants);BROWSER;BROWSER_WEB_HOST</DefineConstants>
    <DefineConstants Condition="'$(BrowserGraphicsBackends)' == 'WebGL'"
      >$(DefineConstants);SAMPLE_BACKEND_WEBGL</DefineConstants
    >
    <DefineConstants Condition="'$(BrowserGraphicsBackends)' == 'WebGPU'"
      >$(DefineConstants);SAMPLE_BACKEND_WEBGPU</DefineConstants
    >
    <DefineConstants Condition="'$(BrowserGraphicsBackends)' == 'Both'"
      >$(DefineConstants);SAMPLE_BACKEND_WEB_AUTO</DefineConstants
    >
    <AssemblyName>BgfXna.Sample.BrowserWebApp</AssemblyName>
    <WasmMainHTMLPath>wwwroot\index.html</WasmMainHTMLPath>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <DefaultWasmHostConfig>browser</DefaultWasmHostConfig>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -s MAX_WEBGL_VERSION=2 -s GL_ENABLE_GET_PROC_ADDRESS=1 --js-library "$(MSBuildProjectDirectory)\browser-webgl-context.js"</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\BgfXna\BgfXna.csproj"
      AdditionalProperties="EnableBrowserTarget=true"
    />
    <Compile Include="..\Shared\*.cs" Link="%(Filename)%(Extension)" />
    <WasmExtraFiles Include="wwwroot\**\*" />
    <HostConfig Include="browser">
      <Host>Browser</Host>
      <HTMLPath>index.html</HTMLPath>
    </HostConfig>
  </ItemGroup>
</Project>
