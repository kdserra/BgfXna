<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);SAMPLE_BACKEND_OPENGLES</DefineConstants>
    <AssemblyName>BgfXna.Sample.iOSOpenGLES</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgfXna\BgfXna.csproj" />
    <Compile Include="..\Shared\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
