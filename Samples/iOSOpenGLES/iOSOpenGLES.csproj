<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);SAMPLE_BACKEND_OPENGLES;IOS_GAME_HOST</DefineConstants>
    <AssemblyName>BgfXna.Sample.iOSOpenGLES</AssemblyName>
    <ApplicationId>com.bgfxna.samples.iosopengles</ApplicationId>
    <ApplicationTitle>BgfXna iOS OpenGLES Sample</ApplicationTitle>
    <ApplicationManifest>Info.plist</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgfXna\BgfXna.csproj" />
    <Compile Include="..\Shared\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
