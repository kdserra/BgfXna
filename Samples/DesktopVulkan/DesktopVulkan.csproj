<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);SAMPLE_BACKEND_VULKAN</DefineConstants>
    <AssemblyName>BgfXna.Sample.DesktopVulkan</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
    <OutputType>WinExe</OutputType>
    <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP_HOST</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);LINUX_DESKTOP_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgfXna\BgfXna.csproj" />
    <Compile Include="..\Shared\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
